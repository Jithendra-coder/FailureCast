flowchart LR
  subgraph CLIENT["01 · EXPERIENCE · USER SPACE"]
    direction TB
    ADMIN(["Workspace administrator"])
    BROWSER["React 18 · TypeScript · Vite<br/>Recharts · Lucide · 8 workspace views"]
    FILES[/"Operator-selected C-MAPSS<br/>train / test / RUL file triplet"/]
    ADMIN --> BROWSER
    FILES --> BROWSER
  end

  subgraph APP["02 · APPLICATION · FAILURECAST API PROCESS"]
    direction TB
    FASTAPI["FastAPI · one Uvicorn process<br/>serves the production Vite build<br/>REST /api/v1 · Pydantic schemas"]
    SECURITY["Production security middleware<br/>signed, expiring admin session · Origin allowlist<br/>login throttle · request bounds · security headers"]
    HANDLERS["API modules<br/>C-MAPSS import + QA · RUL inference<br/>replay · alerts · registry · drift · audit"]
    FASTAPI --> SECURITY --> HANDLERS
  end

  subgraph STATE["03 · LOCAL PERSISTENCE"]
    direction TB
    DB[("SQLite · WAL<br/>dataset + model registry · durable training_jobs<br/>predictions · alerts · audit · sessions · replay")]
    RAW[("data/raw/&lt;version&gt;/<br/>byte-preserved imports<br/>per-file SHA-256")]
  end

  subgraph WORK["04 · ASYNCHRONOUS TRAINING · SEPARATE COMPOSE SERVICE"]
    direction TB
    WORKER["One lock-protected worker<br/>SQLite polling · BEGIN IMMEDIATE claim"]
    FEATURES["Training-only labels + trailing features<br/>engine boundaries preserved"]
    ESTIMATORS["MeanBaseline · RandomForest<br/>HistGradientBoosting<br/>optional PyTorch LSTM"]
    VALIDATION["Seeded 80/20 split by engine ID<br/>candidate · metrics · experiment"]
    WORKER --> FEATURES --> ESTIMATORS --> VALIDATION
  end

  subgraph OUTPUTS["05 · MODEL ARTIFACTS & TRACKING"]
    direction TB
    ARTIFACTS[("artifacts/models<br/>versioned estimator files<br/>artifacts/experiments")]
    MLFLOW[("Local MLflow tracking<br/>artifacts/mlflow.db + mlartifacts")]
    MLFLOWUI["Optional MLflow UI<br/>host port 127.0.0.1:5000"]
    MLFLOW --> MLFLOWUI
  end

  BROWSER <-->|"same-origin REST / JSON<br/>static assets served by FastAPI"| FASTAPI
